{
  "name": "performance-calculator-v3",
  "version": "1.3.0",
  "description": "Signal K performance calculator: true wind triangle, leeway, set & drift, polar targets, VMG. Includes mast-motion correction for apparent wind and data smoothing. Broadcasts results on NMEA 2000 using the same PGN layout as B&G's H5000 CPU so any B&G/Simrad MFD renders them.",
  "main": "index.js",
  "scripts": {
    "test": "node tests/runTests.js"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin",
    "signalk-webapp",
    "performance",
    "polar",
    "H5000",
    "sailing"
  ],
  "author": "Magnus L",
  "license": "MIT",
  "dependencies": {
    "@canboat/canboatjs": "^3.13.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.1",
    "csv-parse": "^5.5.0",
    "express": "^4.18.2"
  },
  "signalk": {
    "appIcon": "icon.png",
    "displayName": "Polar Performance",
    "launchUrl": "/performance-calculator-v3/webapp/index.html"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.10"
  }
}
